{
  "name": "kamiyobi",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "HPC・ネットワーク・システム・AI・セキュリティ会議の締切を JSON/CSV/Pages で配信",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node src/cli.ts build",
    "discover": "node src/cli.ts discover",
    "bench": "node src/bench-recommender.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "check": "biome check src tests",
    "format": "biome format --write src tests"
  },
  "license": "MIT",
  "overrides": {
    "adm-zip": "0.6.0",
    "onnxruntime-node": "1.27.0",
    "sharp": "0.35.3"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "html-entities": "^2.6.0",
    "imapflow": "^1.6.6",
    "js-yaml": "^5.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.2.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
